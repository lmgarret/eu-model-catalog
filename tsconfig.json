{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "paths": { "$lib": ["./site/src/lib"], "$lib/*": ["./site/src/lib/*"] },
    "types": ["node"]
  },
  "include": ["src", "test", "*.ts"]
}
